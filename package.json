{
  "name": "anime-assistant",
  "displayName": "Anime-Assistant",
  "description": "Anime-Assistant — Live2D assistant inside VS Code",
  "icon": "icon.png",
  "version": "0.0.10",
  "publisher": "13e01",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/13e01/Anime-Assistant"
  },
  "bugs": {
    "url": "https://github.com/13e01/Anime-Assistant/issues"
  },
  "homepage": "https://github.com/13e01/Anime-Assistant#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": [
    
    
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "anime.show",
        "title": "Anime: Show Assistant Panel",
        "icon": "$(play)"
      },
      {
        "command": "anime.openTab",
        "title": "Anime: Open Assistant in New Tab",
        "icon": "$(layout-sidebar-right-off)"
      },
      {
        "command": "anime.openCleanTab",
        "title": "Anime: Open Pure Model View",
        "icon": "$(symbol-color)"
      }
    ],
    "keybindings": [
      {
        "command": "anime.show",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "animeView",
          "name": "Anime Assistant",
          "when": "true",
          "icon": "icon.png"
        },
        {
          "type": "webview",
          "id": "animeCleanView",
          "name": "Anime Model",
          "when": "true",
          "icon": "icon.png"
        }
      ]
    },
    "configuration": {
      "title": "Anime Assistant",
      "properties": {
        "animeAssistant.pomodoroWorkMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 120,
          "description": "Pomodoro work interval (minutes)"
        },
        "animeAssistant.pomodoroBreakMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Pomodoro break interval (minutes)"
        },
        "animeAssistant.voiceEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable voice reactions"
        },
        "animeAssistant.extraModelsDir": {
          "type": "string",
          "default": "",
          "description": "Absolute path to an additional folder containing Live2D models (*.model3.json / *.model.json). Leave empty to use only the built-in models."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "eslint": "^9.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}