{
  "name": "anime-assistant",
  "displayName": "Anime-Assistant",
  "description": "Anime-Assistant — Live2D assistant for VS Code",
  "icon": "icon.png",
  "version": "0.0.10",
  "publisher": "13e01",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/13e01/Anime-Assistant"
  },
  "bugs": {
    "url": "https://github.com/13e01/Anime-Assistant/issues"
  },
  "homepage": "https://github.com/13e01/Anime-Assistant#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anime.show",
        "title": "Anime: Show model"
      }
    ],
    "keybindings": [
      {
        "command": "anime.show",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run prepare:overlay && npm run build:overlay",
    "compile": "tsc -p ./",
    "prepare:overlay": "npm --prefix anime-overlay install --omit=optional",
    "build:overlay": "npm --prefix anime-overlay run build",
    "lint": "eslint",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "cowsay": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "eslint": "^9.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
